# ===== MySQL（云端事件中心）=====
MYSQL_ROOT_PASSWORD=smartward_root
MYSQL_DATABASE=smart_ward
MYSQL_USER=smart_ward
MYSQL_PASSWORD=smartward_pass

# ===== MQTT Broker =====
MQTT_BROKER=mqtt-broker
MQTT_PORT=1883

# ===== 端口映射（与 docker-compose.yml 对齐）=====
# MQTT      1884 -> 1883
# MySQL     3308 -> 3306
# 后端 API  8001 -> 8000
# 训练调度  8002 -> 8000
# 护士站    8081 -> 80

# ===== 边缘节点默认参数（可在 docker-compose per-service 覆盖）=====
TICK_SECONDS=3
EVENT_DEDUPE_SECONDS=30

# ===== 真实视觉管线（默认 mock；真实接入时显式启用）=====
CAMERA_MODE=mock
CAMERA_SOURCE=0
INSTALL_YOLO=false
YOLO_MODEL_PATH=/app/models/yolo11n-pose.pt
# Jetson 可填写 0 或 cuda:0；留空使用 Ultralytics 默认设备
YOLO_DEVICE=
YOLO_CONFIDENCE=0.35
YOLO_TRACKER_IOU=0.3
YOLO_TRACKER_MAX_MISSED=8
BEHAVIOR_HISTORY_SIZE=24
YOLO_SAVE_EVIDENCE=false
EVIDENCE_DIR=/app/evidence

# ===== 边缘 LLM（默认 mock；real 模式需要本地 GGUF 文件）=====
LLM_MODE=mock
# quality 路径：Qwen2.5-1.5B Q4；compact 路径：Qwen2.5-0.5B Q4
LLM_PROFILE=quality
LLM_MODEL_PATH=/app/models/qwen2.5-1.5b-gguf/qwen2.5-1.5b-instruct-q4_k_m.gguf
LLM_MODEL_NAME=qwen2.5-1.5b-instruct
LLM_MODEL_VERSION=1.0.0-int4
# 蒸馏学生模型（P5 产出，fetch_edge_llm.py 拉取后切换）：
# LLM_MODEL_PATH=/app/models/qwen2.5-1.5b-ward-distilled/qwen2.5-1.5b-ward-q4_k_m.gguf
# LLM_MODEL_NAME=qwen2.5-1.5b-ward
LLM_N_CTX=512
LLM_N_BATCH=128
LLM_N_UBATCH=128
LLM_N_THREADS=8
LLM_N_THREADS_BATCH=8
LLM_USE_MMAP=true
LLM_USE_MLOCK=false
LLM_MAX_TOKENS=64

# 低内存路径：下载 0.5B 模型后，将下面三项替换为：
# LLM_PROFILE=compact
# LLM_MODEL_PATH=/app/models/qwen2.5-0.5b-gguf/qwen2.5-0.5b-instruct-q4_k_m.gguf
# LLM_MODEL_NAME=qwen2.5-0.5b-instruct

# ===== 演示阶段安全配置（生产环境必须收紧）=====
# MQTT 匿名访问，演示阶段开启；接入真实病房前需启用 ACL/TLS
MQTT_ALLOW_ANONYMOUS=true
